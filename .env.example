# Firebase Web App Configuration (Get from Firebase Console -> Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=

# Only for throwaway demos: allows a build without Firebase keys (data stays in each visitor's browser)
# NEXT_PUBLIC_DEMO_MODE=true

# Admin access is granted only by a Firestore admins/{uid} document or an `admin: true` custom claim.
# (NEXT_PUBLIC_ADMIN_EMAILS is no longer used: public env values ship in the browser bundle.)
